# Copy this file to .env for local dev. Vite only exposes variables prefixed
# VITE_ to client code.

# Leave this UNSET for local dev — vite.config.js's dev-server proxy forwards
# /api/* to the backend (see server/.env's PORT) automatically, so the browser
# never needs an absolute cross-origin URL locally. Only set this to a real
# absolute URL (e.g. your Render URL) when the frontend and backend are
# genuinely on different origins, i.e. production.
# VITE_API_URL=https://your-backend.onrender.com
