# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Server ---
NODE_ENV=development
# Not 5000 — macOS's AirPlay Receiver squats on that port by default, causing
# EADDRINUSE the moment you try to run this locally on a Mac.
PORT=5001

# --- Database ---
# MongoDB Atlas dashboard → Database → Connect → "Connect your application"
MONGODB_URI=

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access token lifetime, e.g. 7d, 12h, 30m
JWT_EXPIRES_IN=7d
# How long a password-reset link stays valid, in minutes
RESET_TOKEN_EXPIRES_MIN=15

# --- CORS ---
# Comma-separated whitelist of origins allowed to call this API. No wildcards.
# Both local dev origins listed so either run mode works without editing this —
# :5173 is native `npm run dev`, :8080 is the Docker Compose path.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Brevo (transactional email, used for password-reset links) ---
# Brevo dashboard → Settings → SMTP & API → API Keys
BREVO_API_KEY=
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs → Senders)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Sunny Charkhwal

# --- Frontend linkage ---
# Base URL used to build the password-reset link emailed to you. Only one value
# possible here (unlike CORS_ORIGIN) — set to whichever mode you actually use to
# click reset links, i.e. the native-dev origin.
FRONTEND_URL=http://localhost:5173
